          "evidenceClassification": "C",
          "evidenceReference": "az-vnet-doc",
          "securityImpact": "Defines the private network boundary. No inbound internet access by default.",
          "costImpact": "No direct charge for the virtual network itself.",
          "userSelectable": false
        },
        {
          "identifier": "azure-nsg",
          "provider": "azure",
          "resourceType": "Microsoft.Network/networkSecurityGroups",
          "required": true,
          "autoIncluded": true,
          "origin": "safety-recommended",
          "reason": "A network security group is attached so inbound access is denied unless an inbound rule is explicitly added by the author.",
          "evidenceClassification": "E",
          "evidenceReference": "az-nsg-doc",
          "securityImpact": "Default posture denies inbound internet traffic. Rules are opt-in and reviewed.",
          "costImpact": "No direct charge for the network security group.",
          "userSelectable": false
        },
        {
          "identifier": "azure-public-ip",
          "provider": "azure",
          "resourceType": "Microsoft.Network/publicIPAddresses",
          "required": false,
          "autoIncluded": false,
          "origin": "user-selectable",
          "reason": "A public IP address is only added when the author explicitly requests inbound internet access to the VM.",
          "evidenceClassification": "E",
          "evidenceReference": "safety-no-public-ip",
          "securityImpact": "Exposes the VM to the public internet. Requires justification and restrictive inbound rules.",
          "costImpact": "Standard public IPv4 addresses incur an hourly charge.",
          "userSelectable": true
        },
        {
          "identifier": "azure-diagnostics-storage",
          "provider": "azure",
          "resourceType": "Microsoft.Storage/storageAccounts (boot diagnostics)",
          "required": false,
          "autoIncluded": false,
          "origin": "user-selectable",
          "reason": "A Storage Account for boot diagnostics is only added when boot diagnostics are explicitly enabled. This is a Storage Account, NOT a managed disk.",
          "evidenceClassification": "C",
          "evidenceReference": "az-disk-doc",
          "securityImpact": "Stores boot diagnostic logs; should not be publicly accessible.",
          "costImpact": "Incurs Storage Account transaction and capacity charges.",
          "userSelectable": true
        }
