          "autoIncluded": true,
          "origin": "provider-required",
          "reason": "The managed OS disk is an intrinsic part of the virtual machine's storageProfile and is created with the VM. It is a managed disk, NOT a Storage Account.",
          "evidenceClassification": "C",
          "evidenceReference": "az-disk-doc",
          "securityImpact": "Managed disks are encrypted at rest with platform-managed keys by default.",
          "costImpact": "OS disk incurs managed-disk storage cost for the lab duration.",
          "userSelectable": false
        },
        {
