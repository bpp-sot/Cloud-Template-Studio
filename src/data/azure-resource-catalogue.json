          "reason": "A network interface is required to connect the virtual machine to a subnet.",
          "evidenceClassification": "C",
          "evidenceReference": "az-nic-doc",
          "securityImpact": "The NIC binds the VM to a subnet governed by a network security group.",
          "costImpact": "No direct charge for the NIC itself.",
          "userSelectable": false
        },
        {
          "identifier": "azure-vnet",
          "provider": "azure",
          "resourceType": "Microsoft.Network/virtualNetworks",
          "required": true,
          "autoIncluded": true,
